@{
    ViewData["Title"] = "Smart School Management";
}

<!-- ========================================================================
     1. HERO SECTION
     ======================================================================== -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <!-- Left Column: Hero Text & CTAs -->
            <div class="col-lg-6 pe-lg-4">
                <div class="hero-pill">
                    <span class="dot"></span>
                    <span>Smarter Schools</span>
                    <span class="dot"></span>
                    <span>Brighter Futures</span>
                </div>

                <h1 class="hero-title">
                    Smart School<br>
                    Management<br>
                    <span class="text-primary-blue">for a Brighter Tomorrow</span>
                </h1>

                <p class="hero-subtitle">
                    A complete and easy-to-use platform to manage students, teachers, academic activities and more — all in one place. Simplify school operations and focus on what truly matters: education.
                </p>

                <div class="hero-buttons">
                    <a href="#features" class="btn-hero-primary">
                        <span>Get Started</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn-hero-secondary">
                        <i class="bi bi-person-fill"></i>
                        <span>Login</span>
                    </a>
                </div>

                <div class="hero-checks">
                    <div class="hero-check-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Easy to Use</span>
                    </div>
                    <div class="hero-check-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Secure & Reliable</span>
                    </div>
                    <div class="hero-check-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Built for Schools</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Interactive Dashboard Mockup & Visuals -->
            <div class="col-lg-6 mt-5 mt-lg-0">
                <div class="mockup-wrapper">
                    <!-- Handwritten Floating Tag -->
                    <div class="handwritten-hero-tag">
                        Manage<br>
                        Educate<br>
                        Grow Together
                        <svg width="45" height="24" viewBox="0 0 50 30" fill="none" class="ms-1">
                            <path d="M5 20C15 25 35 25 45 5" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="3 3"/>
                            <path d="M38 4L45 5L42 12" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>

                    <!-- Paper Airplane Doodle -->
                    <div style="position: absolute; top: -15px; left: 10px; transform: rotate(-15deg); color: #3B82F6;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 2L11 13M22 2L15 22L11 13L2 9L22 2Z" fill="rgba(59, 130, 246, 0.15)"/>
                        </svg>
                    </div>

                    <!-- Dashboard Mockup Card -->
                    <div class="dashboard-mockup-card">
                        <!-- Dark Sidebar -->
                        <div class="mockup-sidebar">
                            <div class="mockup-sidebar-brand">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="#3B82F6">
                                    <path d="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 19.94 8.13 22 12 22C15.87 22 19 19.94 19 17.18V13.18L12 17L5 13.18Z"/>
                                </svg>
                                <span>High School<br><span style="font-size: 0.65rem; color: #64748B;">System</span></span>
                            </div>

                            <ul class="mockup-sidebar-menu">
                                <li><a href="#" class="mockup-menu-item active"><i class="bi bi-grid-fill"></i> Dashboard</a></li>
                                <li><a href="#" class="mockup-menu-item"><i class="bi bi-people-fill"></i> Students</a></li>
                                <li><a href="#" class="mockup-menu-item"><i class="bi bi-person-badge-fill"></i> Teachers</a></li>
                                <li><a href="#" class="mockup-menu-item"><i class="bi bi-calendar-check"></i> Attendance</a></li>
                                <li><a href="#" class="mockup-menu-item"><i class="bi bi-award"></i> Grades</a></li>
                                <li><a href="#" class="mockup-menu-item"><i class="bi bi-book"></i> Classes</a></li>
                                <li><a href="#" class="mockup-menu-item"><i class="bi bi-bell"></i> Notifications</a></li>
                                <li><a href="#" class="mockup-menu-item"><i class="bi bi-graph-up"></i> Reports</a></li>
                            </ul>
                        </div>

                        <!-- Mockup Main Body -->
                        <div class="mockup-content">
                            <!-- Header inside mockup -->
                            <div class="mockup-header">
                                <div>
                                    <h3 class="mockup-header-title">Welcome, Principal!</h3>
                                    <p class="mockup-header-subtitle">Here's what's happening at your school today.</p>
                                </div>
                                <div class="mockup-header-user">
                                    <i class="bi bi-bell text-muted" style="font-size: 0.85rem;"></i>
                                    <div class="mockup-user-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span class="d-none d-sm-inline">Principal <i class="bi bi-chevron-down" style="font-size: 0.6rem;"></i></span>
                                </div>
                            </div>

                            <!-- 4 Metric Cards Grid -->
                            <div class="mockup-stats-grid">
                                <div class="mockup-stat-card">
                                    <div class="mockup-stat-header">
                                        <i class="bi bi-mortarboard-fill text-success"></i>
                                        <span>Students</span>
                                    </div>
                                    <div class="mockup-stat-value">1,240</div>
                                    <div class="mockup-stat-sub positive">+12% from last term</div>
                                </div>
                                <div class="mockup-stat-card">
                                    <div class="mockup-stat-header">
                                        <i class="bi bi-person-workspace text-primary"></i>
                                        <span>Teachers</span>
                                    </div>
                                    <div class="mockup-stat-value">86</div>
                                    <div class="mockup-stat-sub positive">+5% from last term</div>
                                </div>
                                <div class="mockup-stat-card">
                                    <div class="mockup-stat-header">
                                        <i class="bi bi-door-open-fill text-info" style="color: #6366F1 !important;"></i>
                                        <span>Classes</span>
                                    </div>
                                    <div class="mockup-stat-value">42</div>
                                    <div class="mockup-stat-sub neutral">Active classes</div>
                                </div>
                                <div class="mockup-stat-card">
                                    <div class="mockup-stat-header">
                                        <i class="bi bi-book-half text-warning"></i>
                                        <span>Courses</span>
                                    </div>
                                    <div class="mockup-stat-value">128</div>
                                    <div class="mockup-stat-sub neutral">Across all grades</div>
                                </div>
                            </div>

                            <!-- Lower Section: Recent Activities & Attendance -->
                            <div class="mockup-lower-grid">
                                <!-- Recent Activities Panel -->
                                <div class="mockup-panel">
                                    <div class="mockup-panel-title">Recent Activities</div>
                                    <div class="mockup-activity-list">
                                        <div class="mockup-activity-item">
                                            <div class="mockup-activity-icon" style="background-color: #EFF6FF; color: #2563EB;">
                                                <i class="bi bi-person-plus-fill"></i>
                                            </div>
                                            <div style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <div style="font-weight: 600; color: #0F172A;">New student registration</div>
                                                <div style="color: #94A3B8; font-size: 0.58rem;">2 hours ago</div>
                                            </div>
                                        </div>
                                        <div class="mockup-activity-item">
                                            <div class="mockup-activity-icon" style="background-color: #ECFDF5; color: #059669;">
                                                <i class="bi bi-file-earmark-check-fill"></i>
                                            </div>
                                            <div style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <div style="font-weight: 600; color: #0F172A;">Math exam results published</div>
                                                <div style="color: #94A3B8; font-size: 0.58rem;">5 hours ago</div>
                                            </div>
                                        </div>
                                        <div class="mockup-activity-item">
                                            <div class="mockup-activity-icon" style="background-color: #F5F3FF; color: #7C3AED;">
                                                <i class="bi bi-calendar-event-fill"></i>
                                            </div>
                                            <div style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <div style="font-weight: 600; color: #0F172A;">Parent meeting scheduled</div>
                                                <div style="color: #94A3B8; font-size: 0.58rem;">1 day ago</div>
                                            </div>
                                        </div>
                                        <div class="mockup-activity-item">
                                            <div class="mockup-activity-icon" style="background-color: #FFF7ED; color: #EA580C;">
                                                <i class="bi bi-clock-history"></i>
                                            </div>
                                            <div style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                <div style="font-weight: 600; color: #0F172A;">Class timetable updated</div>
                                                <div style="color: #94A3B8; font-size: 0.58rem;">1 day ago</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Class Attendance Panel -->
                                <div class="mockup-panel">
                                    <div class="mockup-panel-title">
                                        <span>Class Attendance</span>
                                        <span style="font-size: 0.58rem; color: #64748B; font-weight: 500;">This Week <i class="bi bi-chevron-down"></i></span>
                                    </div>
                                    <div class="mockup-attendance-body">
                                        <!-- Donut Ring SVG -->
                                        <div class="donut-ring">
                                            <svg width="60" height="60" viewBox="0 0 36 36">
                                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#E2E8F0" stroke-width="3.5" />
                                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#0D9488" stroke-dasharray="92, 100" stroke-width="3.5" stroke-linecap="round"/>
                                            </svg>
                                            <div class="donut-val">
                                                92%
                                                <span>Overall</span>
                                            </div>
                                        </div>

                                        <!-- Mini Bar Chart -->
                                        <div style="flex: 1; display: flex; align-items: flex-end; justify-content: space-between; height: 50px; padding: 0 4px;">
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
                                                <div style="width: 7px; height: 35px; background-color: #3B82F6; border-radius: 2px;"></div>
                                                <span style="font-size: 0.52rem; color: #94A3B8;">Mon</span>
                                            </div>
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
                                                <div style="width: 7px; height: 44px; background-color: #3B82F6; border-radius: 2px;"></div>
                                                <span style="font-size: 0.52rem; color: #94A3B8;">Tue</span>
                                            </div>
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
                                                <div style="width: 7px; height: 38px; background-color: #3B82F6; border-radius: 2px;"></div>
                                                <span style="font-size: 0.52rem; color: #94A3B8;">Wed</span>
                                            </div>
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
                                                <div style="width: 7px; height: 46px; background-color: #3B82F6; border-radius: 2px;"></div>
                                                <span style="font-size: 0.52rem; color: #94A3B8;">Thu</span>
                                            </div>
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 3px;">
                                                <div style="width: 7px; height: 30px; background-color: #93C5FD; border-radius: 2px;"></div>
                                                <span style="font-size: 0.52rem; color: #94A3B8;">Fri</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cute Student Mascot / Study Illustration (Vector SVG) -->
                    <div class="student-illustration-wrap d-none d-xl-block">
                        <svg viewBox="0 0 160 160" width="145" height="145">
                            <!-- Books Stack -->
                            <rect x="75" y="130" width="70" height="12" rx="3" fill="#3B82F6"/>
                            <rect x="70" y="118" width="75" height="12" rx="3" fill="#10B981"/>
                            <rect x="78" y="106" width="65" height="12" rx="3" fill="#F59E0B"/>
                            <!-- Laptop Base -->
                            <path d="M15 135 L65 135 L62 142 L18 142 Z" fill="#94A3B8"/>
                            <rect x="22" y="98" width="38" height="34" rx="3" fill="#0F172A"/>
                            <rect x="25" y="101" width="32" height="28" rx="1" fill="#38BDF8"/>
                            <circle cx="41" cy="115" r="4" fill="#FFFFFF"/>
                            <!-- Student Body -->
                            <path d="M30 75 Q45 65 60 75 L62 105 Q45 110 28 105 Z" fill="#1E40AF"/>
                            <!-- Head & Hair -->
                            <circle cx="45" cy="50" r="18" fill="#FDE68A"/>
                            <!-- Cheerful Hair -->
                            <path d="M28 48 C28 32 62 32 62 48 C62 40 50 35 40 37 C34 38 30 42 28 48 Z" fill="#1F2937"/>
                            <!-- Cute Face -->
                            <circle cx="39" cy="50" r="2" fill="#1F2937"/>
                            <circle cx="51" cy="50" r="2" fill="#1F2937"/>
                            <path d="M42 55 Q45 58 48 55" stroke="#1F2937" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                            <!-- Cheeks -->
                            <circle cx="36" cy="53" r="2.5" fill="#FCA5A5" opacity="0.6"/>
                            <circle cx="54" cy="53" r="2.5" fill="#FCA5A5" opacity="0.6"/>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================
     2. CORE FEATURES SECTION
     ======================================================================== -->
<section class="section-padding text-center" id="features">
    <div class="container">
        <span class="section-tag">Core Features</span>
        <h2 class="section-heading">
            Everything You Need for <span class="text-primary-blue">Efficient School Management</span>
        </h2>
        <p class="section-subtitle">
            Powerful modules designed to simplify academic and administrative tasks.
        </p>

        <div class="row g-4 text-start">
            <!-- 1. Student Management -->
            <div class="col-md-6 col-lg-4 col-xl-2">
                <div class="feature-card">
                    <div class="feature-icon-box" style="background-color: #EFF6FF; color: #2563EB;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h3 class="feature-title">Student Management</h3>
                    <p class="feature-desc">Maintain student records, admissions, and profiles effortlessly.</p>
                </div>
            </div>

            <!-- 2. Attendance Tracking -->
            <div class="col-md-6 col-lg-4 col-xl-2">
                <div class="feature-card">
                    <div class="feature-icon-box" style="background-color: #ECFDF5; color: #059669;">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <h3 class="feature-title">Attendance Tracking</h3>
                    <p class="feature-desc">Track and manage attendance with real-time insights.</p>
                </div>
            </div>

            <!-- 3. Grade Management -->
            <div class="col-md-6 col-lg-4 col-xl-2">
                <div class="feature-card">
                    <div class="feature-icon-box" style="background-color: #F5F3FF; color: #7C3AED;">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <h3 class="feature-title">Grade Management</h3>
                    <p class="feature-desc">Record, analyze and publish grades with ease.</p>
                </div>
            </div>

            <!-- 4. Class Schedule -->
            <div class="col-md-6 col-lg-4 col-xl-2">
                <div class="feature-card">
                    <div class="feature-icon-box" style="background-color: #FFF7ED; color: #EA580C;">
                        <i class="bi bi-calendar-week-fill"></i>
                    </div>
                    <h3 class="feature-title">Class Schedule</h3>
                    <p class="feature-desc">Create and manage class timetables and academic calendars.</p>
                </div>
            </div>

            <!-- 5. Notifications -->
            <div class="col-md-6 col-lg-4 col-xl-2">
                <div class="feature-card">
                    <div class="feature-icon-box" style="background-color: #FEF2F2; color: #DC2626;">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <h3 class="feature-title">Notifications</h3>
                    <p class="feature-desc">Send instant updates to students, parents and staff.</p>
                </div>
            </div>

            <!-- 6. Reports -->
            <div class="col-md-6 col-lg-4 col-xl-2">
                <div class="feature-card">
                    <div class="feature-icon-box" style="background-color: #F0FDFA; color: #0D9488;">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                    <h3 class="feature-title">Reports</h3>
                    <p class="feature-desc">Generate detailed reports for better decision making.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================
     3. STATISTICS BANNER ROW
     ======================================================================== -->
<section class="stats-banner">
    <div class="container">
        <div class="row align-items-center">
            <!-- 1,240 Students -->
            <div class="col-6 col-md-3 col-lg-2">
                <div class="stat-item">
                    <div class="stat-icon-circle" style="background-color: #EFF6FF; color: #2563EB;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div>
                        <div class="stat-number">1,240</div>
                        <div class="stat-label">Students</div>
                    </div>
                </div>
            </div>

            <!-- 86 Teachers -->
            <div class="col-6 col-md-3 col-lg-2">
                <div class="stat-item">
                    <div class="stat-icon-circle" style="background-color: #ECFDF5; color: #059669;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <div class="stat-number">86</div>
                        <div class="stat-label">Teachers</div>
                    </div>
                </div>
            </div>

            <!-- 42 Classes -->
            <div class="col-6 col-md-3 col-lg-2">
                <div class="stat-item">
                    <div class="stat-icon-circle" style="background-color: #F5F3FF; color: #7C3AED;">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                    <div>
                        <div class="stat-number">42</div>
                        <div class="stat-label">Classes</div>
                    </div>
                </div>
            </div>

            <!-- 128 Courses -->
            <div class="col-6 col-md-3 col-lg-2">
                <div class="stat-item">
                    <div class="stat-icon-circle" style="background-color: #FFF7ED; color: #EA580C;">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <div>
                        <div class="stat-number">128</div>
                        <div class="stat-label">Courses</div>
                    </div>
                </div>
            </div>

            <!-- Handwritten Accent -->
            <div class="col-12 col-lg-4 mt-3 mt-lg-0">
                <div class="handwritten-banner-note">
                    <span>A Better Learning Experience for Everyone</span>
                    <svg class="handwritten-curve" viewBox="0 0 150 15" fill="none">
                        <path d="M5 8 C40 14, 100 2, 145 10" stroke="#10B981" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================================
     4. "FOR EVERYONE" COMMUNITY SECTION
     ======================================================================== -->
<section class="community-section" id="about">
    <div class="container text-center">
        <span class="section-tag">For Everyone</span>
        <h2 class="section-heading">
            A Platform Designed for the <span class="text-primary-blue">Entire School Community</span>
        </h2>
        <p class="section-subtitle">
            Different needs, one powerful platform.
        </p>

        <div class="row g-4 text-start">
            <!-- 1. For Teachers -->
            <div class="col-md-6 col-lg-3">
                <div class="persona-card">
                    <div class="persona-header">
                        <div class="persona-avatar" style="background-color: #EFF6FF;">
                            <!-- Female Teacher SVG Avatar -->
                            <svg width="38" height="38" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="48" fill="#DBEAFE"/>
                                <circle cx="50" cy="42" r="20" fill="#FDE68A"/>
                                <path d="M30 40 C30 20 70 20 70 40 C70 54 62 60 50 60 C38 60 30 54 30 40 Z" fill="#1E293B"/>
                                <path d="M22 88 C25 68 75 68 78 88 Z" fill="#2563EB"/>
                                <circle cx="43" cy="42" r="2.5" fill="#1E293B"/>
                                <circle cx="57" cy="42" r="2.5" fill="#1E293B"/>
                                <path d="M46 50 Q50 54 54 50" stroke="#1E293B" stroke-width="2" fill="none" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h3 class="persona-title">For Teachers</h3>
                    </div>
                    <ul class="persona-checklist">
                        <li><i class="bi bi-check-circle-fill"></i> Manage classes and attendance</li>
                        <li><i class="bi bi-check-circle-fill"></i> Record and publish grades</li>
                        <li><i class="bi bi-check-circle-fill"></i> Communicate with students easily</li>
                    </ul>
                </div>
            </div>

            <!-- 2. For Students -->
            <div class="col-md-6 col-lg-3">
                <div class="persona-card">
                    <div class="persona-header">
                        <div class="persona-avatar" style="background-color: #ECFDF5;">
                            <!-- Male Student SVG Avatar -->
                            <svg width="38" height="38" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="48" fill="#D1FAE5"/>
                                <circle cx="50" cy="42" r="20" fill="#FDE68A"/>
                                <path d="M30 38 C32 20 68 20 70 38 C70 25 58 24 50 24 C40 24 30 28 30 38 Z" fill="#047857"/>
                                <path d="M25 88 C28 68 72 68 75 88 Z" fill="#059669"/>
                                <circle cx="43" cy="43" r="2.5" fill="#064E3B"/>
                                <circle cx="57" cy="43" r="2.5" fill="#064E3B"/>
                                <path d="M45 51 Q50 56 55 51" stroke="#064E3B" stroke-width="2" fill="none" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h3 class="persona-title">For Students</h3>
                    </div>
                    <ul class="persona-checklist">
                        <li><i class="bi bi-check-circle-fill"></i> View class schedules</li>
                        <li><i class="bi bi-check-circle-fill"></i> Check grades and progress</li>
                        <li><i class="bi bi-check-circle-fill"></i> Stay updated with announcements</li>
                    </ul>
                </div>
            </div>

            <!-- 3. For Parents -->
            <div class="col-md-6 col-lg-3">
                <div class="persona-card">
                    <div class="persona-header">
                        <div class="persona-avatar" style="background-color: #FFF7ED;">
                            <!-- Mother / Parent SVG Avatar -->
                            <svg width="38" height="38" viewBox="0 0 100 100">
                                <circle cx="50" cy="50" r="48" fill="#FFEDD5"/>
                                <circle cx="50" cy="44" r="20" fill="#FED7AA"/>
                                <path d="M28 42 C28 22 72 22 72 42 C72 58 64 62 50 62 C36 62 28 58 28 42 Z" fill="#9A3412"/>
                                <path d="M24 88 C28 70 72 70 76 88 Z" fill="#EA580C"/>
                                <circle cx="44" cy="44" r="2.5" fill="#7C2D12"/>
                                <circle cx="56" cy="44" r="2.5" fill="#7C2D12"/>
                                <path d="M46 52 Q50 56 54 52" stroke="#7C2D12" stroke-width="2" fill="none" stroke-linecap="round"/>
                            </svg>
                        </div>
                        <h3 class="persona-title">For Parents</h3>
                    </div>
