@model HSMS.MVC.ViewModels.Auth.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập - High School Management System";
    Layout = "_Layout";
}

<div class="login-page-wrapper">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5 col-xl-4">
                <div class="login-card">
                    <!-- Brand Header -->
                    <div class="text-center mb-4">
                        <div class="login-brand-icon-wrap mb-3">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="#2563EB">
                                <path d="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 19.94 8.13 22 12 22C15.87 22 19 19.94 19 17.18V13.18L12 17L5 13.18Z"/>
                            </svg>
                        </div>
                        <h2 class="login-title">Đăng nhập</h2>
                        <p class="login-subtitle">Chào mừng bạn quay lại Cổng thông tin trường học</p>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                    }

                    <!-- Alert Errors -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0"></i>
                            <div>
                                <div class="fw-bold mb-1">Xác thực không thành công:</div>
                                <div asp-validation-summary="All" class="mb-0 text-danger-emphasis small"></div>
                            </div>
                        </div>
                    }

                    <!-- Login Form -->
                    <form asp-controller="Auth" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <!-- Username or Email -->
                        <div class="mb-3">
                            <label asp-for="UsernameOrEmail" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="UsernameOrEmail" 
                                       class="form-control border-start-0 ps-0" 
                                       placeholder="Tên đăng nhập hoặc email" 
                                       autocomplete="username" 
                                       autofocus />
                            </div>
                            <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Password" class="form-label fw-semibold text-dark small mb-0"></label>
                                <a asp-controller="Auth" asp-action="ForgotPassword" class="text-primary small text-decoration-none fw-medium">Quên mật khẩu?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Password" 
                                       type="password" 
                                       class="form-control border-start-0 border-end-0 ps-0" 
                                       id="passwordInput"
                                       placeholder="Mật khẩu của bạn" 
                                       autocomplete="current-password" />
                                <button type="button" class="input-group-text bg-white border-start-0 text-muted" id="togglePasswordBtn" tabindex="-1">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        @* Đăng nhập chỉ dùng Session, không cung cấp tùy chọn cookie đăng nhập lâu dài. *@

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-pill shadow-sm mb-3">
                            <span>Đăng nhập</span>
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                        <div class="text-center">
                            <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                                <i class="bi bi-chevron-left"></i> Quay lại trang chủ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.login-page-wrapper {
    background: radial-gradient(ellipse at 50% 20%, rgba(219, 234, 254, 0.45) 0%, rgba(255, 255, 255, 0) 70%);
    min-height: calc(100vh - 180px);
    display: flex;
    align-items: center;
}

.login-card {
    background: #FFFFFF;
    border-radius: 18px;
    padding: 2.25rem 2rem;
    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(226, 232, 240, 0.8);
}

.login-brand-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #EFF6FF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.login-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0F172A;
    margin-bottom: 0.35rem;
}

.login-subtitle {
    font-size: 0.88rem;
    color: #64748B;
    margin: 0;
}

.form-control:focus {
    box-shadow: none;
    border-color: #2563EB;
}

.input-group:focus-within {
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    border-radius: 6px;
}

.input-group:focus-within .input-group-text,
.input-group:focus-within .form-control {
    border-color: #2563EB;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('togglePasswordIcon');

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.classList.toggle('bi-eye');
                toggleIcon.classList.toggle('bi-eye-slash');
            });
        }
    </script>
}
