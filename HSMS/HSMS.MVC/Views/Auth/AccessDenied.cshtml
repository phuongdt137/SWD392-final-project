@{
    ViewData["Title"] = "Từ chối truy cập - High School Management System";
    Layout = "_Layout";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-4 shadow-sm border border-light">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Từ chối truy cập</h2>
                <p class="text-muted mb-4">
                    Bạn không có quyền truy cập vào chức năng hoặc khu vực này. Vui lòng liên hệ với Quản trị viên nếu bạn nghĩ đây là sự nhầm lẫn.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="bi bi-house-door-fill me-1"></i> Trang chủ
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-person-circle me-1"></i> Đăng nhập tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
