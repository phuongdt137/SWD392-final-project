@model HSMS.MVC.ViewModels.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu - High School Management System";
    Layout = "_Layout";
}

<div class="auth-page-wrapper">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5 col-xl-4">
                <div class="auth-card">
                    <!-- Brand Header -->
                    <div class="text-center mb-4">
                        <div class="auth-brand-icon-wrap mb-3">
                            <i class="bi bi-envelope-paper-heart-fill fs-2 text-primary"></i>
                        </div>
                        <h2 class="auth-title">Quên mật khẩu?</h2>
                        <p class="auth-subtitle">Nhập email tài khoản của bạn để nhận liên kết đặt lại mật khẩu</p>
                    </div>

                    <!-- Success Alert -->
                    @if (ViewBag.SuccessMessage != null)
                    {
                        <div class="alert alert-success d-flex align-items-start gap-2 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill fs-5 mt-1 flex-shrink-0"></i>
                            <div>
                                <div class="fw-bold mb-1">Yêu cầu đã được gửi!</div>
                                <div class="small">@ViewBag.SuccessMessage</div>
                            </div>
                        </div>
                    }

                    <!-- Alert Errors -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0"></i>
                            <div>
                                <div class="fw-bold mb-1">Lỗi yêu cầu:</div>
                                <div asp-validation-summary="All" class="mb-0 text-danger-emphasis small"></div>
                            </div>
                        </div>
                    }

                    <!-- Form -->
                    <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Email -->
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email" 
                                       type="email" 
                                       class="form-control border-start-0 ps-0" 
                                       placeholder="ví dụ: admin@hsms.edu.vn" 
                                       autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-pill shadow-sm mb-3">
                            <span>Gửi liên kết đặt lại</span>
                            <i class="bi bi-send ms-2"></i>
                        </button>

                        <div class="text-center">
                            <a asp-controller="Auth" asp-action="Login" class="text-muted small text-decoration-none">
                                <i class="bi bi-chevron-left"></i> Quay lại trang Đăng nhập
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.auth-page-wrapper {
    background: radial-gradient(ellipse at 50% 20%, rgba(219, 234, 254, 0.45) 0%, rgba(255, 255, 255, 0) 70%);
    min-height: calc(100vh - 180px);
    display: flex;
    align-items: center;
}

.auth-card {
    background: #FFFFFF;
    border-radius: 18px;
    padding: 2.25rem 2rem;
    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(226, 232, 240, 0.8);
}

.auth-brand-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #EFF6FF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.auth-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0F172A;
    margin-bottom: 0.35rem;
}

.auth-subtitle {
    font-size: 0.88rem;
    color: #64748B;
    margin: 0;
}

.form-control:focus {
    box-shadow: none;
    border-color: #2563EB;
}

.input-group:focus-within {
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    border-radius: 6px;
}

.input-group:focus-within .input-group-text,
.input-group:focus-within .form-control {
    border-color: #2563EB;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

