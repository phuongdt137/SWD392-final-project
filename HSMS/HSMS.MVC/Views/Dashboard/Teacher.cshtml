@model HSMS.MVC.DTOs.Auth.LoginResponseDto?

@{
    ViewData["Title"] = "Teacher Dashboard - High School Management System";
    Layout = "_DashboardLayout";

    var attendance = ViewData["AttendanceSummary"] as HSMS.MVC.DTOs.Attendance.AttendanceSummary ?? new(0, 0, 0, 0);
    var displayName = Model?.FullName ?? Model?.Username ?? "Giáo viên";
    var dashboardTitle = "Teacher Dashboard";
}

<!-- ==========================================
     1. WELCOME BANNER
     ========================================== -->
<div class="welcome-banner d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
    <div>
        <h1 class="welcome-title">@dashboardTitle</h1>
        <p class="welcome-subtitle">
            Welcome back, <strong>@displayName</strong>! Here's an overview of your classes, students, and teaching activities for today.
        </p>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="d-none d-md-block text-end">
            <span style="font-family: 'Caveat', cursive; font-size: 1.35rem; color: #2563EB; font-weight: 700; line-height: 1.1; display: block;">
                Inspire. Guide.<br>Empower Every Student
            </span>
        </div>
        <div class="welcome-quote-card d-none d-sm-block">
            "Great teachers create brighter tomorrows."
        </div>
    </div>
</div>

<!-- ==========================================
     2. 4 TOP KPI STAT CARDS
     ========================================== -->
<div class="row g-3 mb-4">
    <!-- Today's Classes -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center">
                <div class="kpi-icon-wrap kpi-icon-blue">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-title">Today's Classes</div>
                    <div class="kpi-value">4</div>
                    <div class="kpi-subtext">out of 6 scheduled</div>
                </div>
            </div>
            <div class="kpi-arrow-btn">
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>

    <!-- Pending Attendance -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center">
                <div class="kpi-icon-wrap kpi-icon-green">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-title">Tiết còn thiếu điểm danh</div>
                    <div class="kpi-value">@attendance.Pending</div>
                    <div class="kpi-subtext">Tiết đã đến giờ nhưng chưa đủ kết quả</div>
                </div>
            </div>
            <div class="kpi-arrow-btn">
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>

    <!-- Assignments to Review -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center">
                <div class="kpi-icon-wrap kpi-icon-orange">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-title">Assignments to Review</div>
                    <div class="kpi-value">12</div>
                    <div class="kpi-subtext">submissions pending</div>
                </div>
            </div>
            <div class="kpi-arrow-btn">
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>

    <!-- Average Class Performance -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center">
                <div class="kpi-icon-wrap kpi-icon-purple">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-title">Average Class Performance</div>
                    <div class="kpi-value">86% <span style="font-size: 1rem; color: #10B981;">↑</span></div>
                    <div class="kpi-subtext"><span class="kpi-subtext-up">+4%</span> from last month</div>
                </div>
            </div>
            <div class="kpi-arrow-btn">
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     3. MAIN GRID (SCHEDULE - CLASSES - CHARTS)
     ========================================== -->
<div class="row g-4 mb-4">
    <!-- COLUMN 1: Today's Schedule -->
    <div class="col-12 col-lg-4">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title">
                    <i class="bi bi-calendar-check text-primary"></i>
                    <span>Today's Schedule</span>
                </h3>
                <a asp-controller="Timetable" asp-action="Index" class="dash-card-link">View Full Schedule &rarr;</a>
            </div>

            <div class="schedule-list">
                <div class="schedule-item">
                    <span class="schedule-dot dot-green"></span>
                    <div class="schedule-info">
                        <div class="schedule-period">Period 1 &bull; 8:00 AM – 8:50 AM</div>
                        <div class="schedule-name">Grade 10A1 &ndash; English Literature</div>
                    </div>
                    <span class="schedule-room-badge">Room 101</span>
                </div>

                <div class="schedule-item">
                    <span class="schedule-dot dot-blue"></span>
                    <div class="schedule-info">
                        <div class="schedule-period">Period 2 &bull; 9:00 AM – 9:50 AM</div>
                        <div class="schedule-name">Grade 11B1 &ndash; Creative Writing</div>
                    </div>
                    <span class="schedule-room-badge">Room 203</span>
                </div>

                <div class="schedule-item">
                    <span class="schedule-dot dot-green"></span>
                    <div class="schedule-info">
                        <div class="schedule-period">Period 3 &bull; 10:10 AM – 11:00 AM</div>
                        <div class="schedule-name">Grade 10A2 &ndash; English Literature</div>
                    </div>
                    <span class="schedule-room-badge">Room 102</span>
                </div>

                <div class="schedule-item">
                    <span class="schedule-dot dot-green"></span>
                    <div class="schedule-info">
                        <div class="schedule-period">Period 4 &bull; 11:10 AM – 12:00 PM</div>
                        <div class="schedule-name">Grade 12A1 &ndash; Advanced English</div>
                    </div>
                    <span class="schedule-room-badge">Room 201</span>
                </div>

                <div class="schedule-item">
                    <span class="schedule-dot dot-gray"></span>
                    <div class="schedule-info">
                        <div class="schedule-period">Period 5 &bull; 1:00 PM – 1:50 PM</div>
                        <div class="schedule-name text-muted">Planning Time</div>
                    </div>
                    <span class="badge bg-light text-muted border">&ndash;</span>
                </div>

                <div class="schedule-item">
                    <span class="schedule-dot dot-gray"></span>
                    <div class="schedule-info">
                        <div class="schedule-period">Period 6 &bull; 2:00 PM – 2:50 PM</div>
                        <div class="schedule-name text-muted">Faculty Meeting</div>
                    </div>
                    <span class="badge bg-light text-muted border">&ndash;</span>
                </div>
            </div>
        </div>
    </div>

    <!-- COLUMN 2: My Classes -->
    <div class="col-12 col-lg-4">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title">
                    <i class="bi bi-people-fill text-primary"></i>
                    <span>My Classes</span>
                </h3>
                <a href="#classes" class="dash-card-link">View All Classes &rarr;</a>
            </div>

            <div class="class-list">
                <a href="#class10a1" class="class-item">
                    <div class="class-badge badge-blue">10A1</div>
                    <div class="class-details">
                        <div class="class-title">Grade 10A1</div>
                        <div class="class-meta">
                            <span><i class="bi bi-person me-1"></i>28 Students</span>
                            <span><i class="bi bi-journal-check me-1"></i>4 Assignments</span>
                            <span><i class="bi bi-graph-up me-1"></i>86% Avg.</span>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>

                <a href="#class10a2" class="class-item">
                    <div class="class-badge badge-green">10A2</div>
                    <div class="class-details">
                        <div class="class-title">Grade 10A2</div>
                        <div class="class-meta">
                            <span><i class="bi bi-person me-1"></i>30 Students</span>
                            <span><i class="bi bi-journal-check me-1"></i>3 Assignments</span>
                            <span><i class="bi bi-graph-up me-1"></i>82% Avg.</span>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>

                <a href="#class11b1" class="class-item">
                    <div class="class-badge badge-purple">11B1</div>
                    <div class="class-details">
                        <div class="class-title">Grade 11B1</div>
                        <div class="class-meta">
                            <span><i class="bi bi-person me-1"></i>26 Students</span>
                            <span><i class="bi bi-journal-check me-1"></i>5 Assignments</span>
                            <span><i class="bi bi-graph-up me-1"></i>89% Avg.</span>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>

                <a href="#class12a1" class="class-item">
                    <div class="class-badge badge-orange">12A1</div>
                    <div class="class-details">
                        <div class="class-title">Grade 12A1</div>
                        <div class="class-meta">
                            <span><i class="bi bi-person me-1"></i>27 Students</span>
                            <span><i class="bi bi-journal-check me-1"></i>4 Assignments</span>
                            <span><i class="bi bi-graph-up me-1"></i>88% Avg.</span>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- COLUMN 3: Attendance & Performance Charts -->
    <div class="col-12 col-lg-4 d-flex flex-column gap-4">
        <!-- Attendance Overview -->
        <div class="dash-card"><h3 class="h6">Chuyên cần hôm nay</h3><partial name="_AttendanceSummary" model="attendance" /></div>

        <!-- Student Performance Bar Chart -->
        <div class="dash-card flex-1">
            <div class="dash-card-header mb-2">
                <h3 class="dash-card-title">
                    <i class="bi bi-bar-chart-line-fill text-primary"></i>
                    <span>Student Performance</span>
                </h3>
                <select class="form-select form-select-sm" style="width: auto; font-size: 0.8rem; border-radius: 8px;">
                    <option>This Term</option>
                    <option>Last Term</option>
                </select>
            </div>

            <!-- CSS Bar Chart -->
            <div style="height: 100px; display: flex; align-items: flex-end; justify-content: space-around; padding-top: 10px;">
                <div class="text-center" style="width: 45px;">
                    <div class="small fw-bold text-dark mb-1" style="font-size: 0.72rem;">86%</div>
                    <div style="height: 60px; background: #3B82F6; border-radius: 6px 6px 0 0;"></div>
                    <div class="text-muted mt-1" style="font-size: 0.72rem; font-weight: 600;">10A1</div>
                </div>
                <div class="text-center" style="width: 45px;">
                    <div class="small fw-bold text-dark mb-1" style="font-size: 0.72rem;">82%</div>
                    <div style="height: 55px; background: #10B981; border-radius: 6px 6px 0 0;"></div>
                    <div class="text-muted mt-1" style="font-size: 0.72rem; font-weight: 600;">10A2</div>
                </div>
                <div class="text-center" style="width: 45px;">
                    <div class="small fw-bold text-dark mb-1" style="font-size: 0.72rem;">89%</div>
                    <div style="height: 65px; background: #8B5CF6; border-radius: 6px 6px 0 0;"></div>
                    <div class="text-muted mt-1" style="font-size: 0.72rem; font-weight: 600;">11B1</div>
                </div>
                <div class="text-center" style="width: 45px;">
                    <div class="small fw-bold text-dark mb-1" style="font-size: 0.72rem;">88%</div>
                    <div style="height: 62px; background: #F59E0B; border-radius: 6px 6px 0 0;"></div>
                    <div class="text-muted mt-1" style="font-size: 0.72rem; font-weight: 600;">12A1</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     4. BOTTOM ROW: ANNOUNCEMENTS & QUICK ACTIONS
     ========================================== -->
<div class="row g-4">
    <!-- Recent Announcements -->
    <div class="col-12 col-lg-7">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title">
                    <i class="bi bi-megaphone-fill text-primary"></i>
                    <span>Recent Announcements</span>
                </h3>
                <a href="#announcements" class="dash-card-link">View All &rarr;</a>
            </div>

            <div class="d-flex flex-column gap-3">
                <!-- Announcement 1 -->
                <div class="d-flex align-items-start gap-3 p-2 rounded-3 hover-bg">
                    <div style="width: 42px; height: 42px; border-radius: 10px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <div class="flex-1">
                        <div class="fw-bold text-dark small mb-1">Parent-Teacher Meeting</div>
                        <div class="text-muted" style="font-size: 0.8rem; line-height: 1.35;">
                            The next parent-teacher meeting will be held on March 20, 2024 at 4:00 PM in the main auditorium.
                        </div>
                    </div>
                    <div class="text-end flex-shrink-0">
                        <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">Mar 12, 2024</span>
                    </div>
                </div>

                <!-- Announcement 2 -->
                <div class="d-flex align-items-start gap-3 p-2 rounded-3 hover-bg">
                    <div style="width: 42px; height: 42px; border-radius: 10px; background: #ECFDF5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="bi bi-calendar-range"></i>
                    </div>
                    <div class="flex-1">
                        <div class="fw-bold text-dark small mb-1">Spring Break</div>
                        <div class="text-muted" style="font-size: 0.8rem; line-height: 1.35;">
                            The school will be closed for spring break from March 25 &ndash; March 29, 2024. Classes will resume on April 1.
                        </div>
                    </div>
                    <div class="text-end flex-shrink-0">
                        <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">Mar 10, 2024</span>
                    </div>
                </div>

                <!-- Announcement 3 -->
                <div class="d-flex align-items-start gap-3 p-2 rounded-3 hover-bg">
                    <div style="width: 42px; height: 42px; border-radius: 10px; background: #F5F3FF; color: #7C3AED; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <div class="flex-1">
                        <div class="fw-bold text-dark small mb-1">New Science Lab Opening</div>
                        <div class="text-muted" style="font-size: 0.8rem; line-height: 1.35;">
                            We are excited to announce the opening of our new science laboratory. More details will be shared soon.
                        </div>
                    </div>
                    <div class="text-end flex-shrink-0">
                        <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">Mar 8, 2024</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-12 col-lg-5">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title">
                    <i class="bi bi-lightning-charge-fill text-primary"></i>
                    <span>Quick Actions</span>
                </h3>
            </div>

            <div class="quick-actions-grid">
                <!-- Action 1: Take Attendance -->
                <a asp-controller="Attendance" asp-action="Index" class="action-tile">
                    <div class="action-icon" style="background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div>
                        <div class="action-title">Take Attendance</div>
                        <div class="action-desc">Mark today's attendance</div>
                    </div>
                    <i class="bi bi-arrow-right action-arrow text-primary"></i>
                </a>

                <!-- Action 2: Enter Grades -->
                <a href="#grades" class="action-tile">
                    <div class="action-icon" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>
                    <div>
                        <div class="action-title">Enter Grades</div>
                        <div class="action-desc">Record student grades</div>
                    </div>
                    <i class="bi bi-arrow-right action-arrow text-success"></i>
                </a>

                <!-- Action 3: Create Assignment -->
                <a href="#assignment" class="action-tile">
                    <div class="action-icon" style="background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);">
                        <i class="bi bi-file-earmark-plus"></i>
                    </div>
                    <div>
                        <div class="action-title">Create Assignment</div>
                        <div class="action-desc">Add a new assignment</div>
                    </div>
                    <i class="bi bi-arrow-right action-arrow text-warning"></i>
                </a>

                <!-- Action 4: Message Parents -->
                <a href="#messages" class="action-tile">
                    <div class="action-icon" style="background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);">
                        <i class="bi bi-chat-dots"></i>
                    </div>
                    <div>
                        <div class="action-title">Message Parents</div>
                        <div class="action-desc">Send updates to parents</div>
                    </div>
                    <i class="bi bi-arrow-right action-arrow text-purple" style="color: #8B5CF6;"></i>
                </a>
            </div>
        </div>
    </div>
</div>

