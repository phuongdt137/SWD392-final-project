@model HSMS.MVC.DTOs.Auth.LoginResponseDto?

@{
    ViewData["Title"] = "Student Dashboard - High School Management System";
    Layout = "_DashboardLayout";

    var displayName = Model?.FullName ?? Model?.Username ?? "Học sinh";
}

<!-- ==========================================
     1. WELCOME BANNER (STUDENT)
     ========================================== -->
<div class="welcome-banner d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
    <div>
        <h1 class="welcome-title">Student Learning Dashboard</h1>
        <p class="welcome-subtitle">
            Chào mừng bạn quay lại, <strong>@displayName</strong>! Chúc bạn có một ngày học tập hứng khởi và đạt kết quả thật tốt.
        </p>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="d-none d-md-block text-end">
            <span style="font-family: 'Caveat', cursive; font-size: 1.35rem; color: #2563EB; font-weight: 700; line-height: 1.1; display: block;">
                Learn. Grow.<br>Shape Your Bright Future
            </span>
        </div>
        <div class="welcome-quote-card d-none d-sm-block">
            "Tri thức mở lối cho tương lai."
        </div>
    </div>
</div>

<!-- ==========================================
     2. 4 TOP KPI STAT CARDS
     ========================================== -->
<div class="row g-3 mb-4">
    <!-- GPA -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center">
                <div class="kpi-icon-wrap kpi-icon-blue">
                    <i class="bi bi-award-fill"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-title">Điểm Trung Bình (GPA)</div>
                    <div class="kpi-value">8.4 <span class="fs-6 text-success fw-bold">/10</span></div>
                    <div class="kpi-subtext">Học lực: <strong>Giỏi</strong> (Top 5 lớp)</div>
                </div>
            </div>
            <div class="kpi-arrow-btn">
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>

    <!-- Upcoming Tests -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center">
                <div class="kpi-icon-wrap kpi-icon-amber">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-title">Kiểm tra sắp tới</div>
                    <div class="kpi-value">3</div>
                    <div class="kpi-subtext">Toán, Vật lý, Tiếng Anh</div>
                </div>
            </div>
            <div class="kpi-arrow-btn">
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>

    <!-- Conduct -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="d-flex align-items-center">
                <div class="kpi-icon-wrap kpi-icon-purple">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div class="kpi-content">
                    <div class="kpi-title">Rèn luyện & Hạnh kiểm</div>
                    <div class="kpi-value">Tốt</div>
                    <div class="kpi-subtext">Điểm rèn luyện: 95/100</div>
                </div>
            </div>
            <div class="kpi-arrow-btn">
                <i class="bi bi-chevron-right"></i>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     3. 3-COLUMN MAIN CONTENT SECTION
     ========================================== -->
<div class="row g-4 mb-4">
    <!-- Column 1: Today's Timetable -->
    <div class="col-12 col-lg-4">
        <div class="dash-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="dash-card-title mb-0">Lịch Học Hôm Nay</h2>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small fw-semibold">Thứ Hai</span>
            </div>

            <div class="timeline-container">
                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="timeline-period">Tiết 1: Toán học</span>
                            <span class="timeline-room">Phòng 201</span>
                        </div>
                        <div class="timeline-subject">Đại số: Khảo sát hàm số</div>
                        <div class="timeline-time"><i class="bi bi-clock me-1"></i>07:30 - 08:15 (Thầy Tuấn)</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="timeline-period">Tiết 2: Ngữ văn</span>
                            <span class="timeline-room">Phòng 201</span>
                        </div>
                        <div class="timeline-subject">Văn học hiện đại Việt Nam</div>
                        <div class="timeline-time"><i class="bi bi-clock me-1"></i>08:20 - 09:05 (Cô Lan)</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="timeline-period">Tiết 3: Tiếng Anh</span>
                            <span class="timeline-room">Lab Ngoại ngữ</span>
                        </div>
                        <div class="timeline-subject">Unit 4: Global Ecology & Climate</div>
                        <div class="timeline-time"><i class="bi bi-clock me-1"></i>09:20 - 10:05 (Thầy Minh)</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="timeline-period">Tiết 4: Vật lý</span>
                            <span class="timeline-room">Phòng 201</span>
                        </div>
                        <div class="timeline-subject">Dao động cơ và con lắc lò xo</div>
                        <div class="timeline-time"><i class="bi bi-clock me-1"></i>10:10 - 10:55 (Thầy Nam)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Column 2: Recent Subject Scores -->
    <div class="col-12 col-lg-4">
        <div class="dash-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="dash-card-title mb-0">Điểm Số Mới Nhất</h2>
                <a href="#scores" class="text-primary text-decoration-none small fw-semibold">Xem bảng điểm</a>
            </div>

            <div class="class-card mb-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="class-name">Toán học</div>
                    <span class="badge bg-success-subtle text-success fs-6 fw-bold">9.0</span>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small">
                    <span>Kiểm tra 15 phút (Đại số)</span>
                    <span>Hệ số 1</span>
                </div>
            </div>

            <div class="class-card mb-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="class-name">Vật lý</div>
                    <span class="badge bg-primary-subtle text-primary fs-6 fw-bold">8.5</span>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small">
                    <span>Kiểm tra 1 tiết (Chương 1)</span>
                    <span>Hệ số 2</span>
                </div>
            </div>

            <div class="class-card mb-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="class-name">Tiếng Anh</div>
                    <span class="badge bg-primary-subtle text-primary fs-6 fw-bold">8.8</span>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small">
                    <span>Đánh giá kỹ năng Nói & Viết</span>
                    <span>Hệ số 1</span>
                </div>
            </div>

            <div class="class-card mb-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="class-name">Hóa học</div>
                    <span class="badge bg-warning-subtle text-warning fs-6 fw-bold">7.8</span>
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted small">
                    <span>Kiểm tra thực hành phòng thí nghiệm</span>
                    <span>Hệ số 1</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Column 3: Performance Distribution -->
    <div class="col-12 col-lg-4">
        <div class="dash-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="dash-card-title mb-0">Năng Lực Học Tập Theo Nhóm Môn</h2>
                <span class="badge bg-info-subtle text-info small fw-semibold">Học kỳ I</span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-dark">Nhóm KHTN (Toán, Lý, Hóa, Sinh)</span>
                    <span class="small fw-bold text-primary">8.6 / 10</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-primary" style="width: 86%"></div>
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-dark">Nhóm KHXH (Văn, Sử, Địa, GDCD)</span>
                    <span class="small fw-bold text-success">8.2 / 10</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-success" style="width: 82%"></div>
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-dark">Ngoại ngữ (Tiếng Anh)</span>
                    <span class="small fw-bold text-info">8.8 / 10</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-info" style="width: 88%"></div>
                </div>
            </div>

            <div class="p-3 bg-light rounded-3 mt-auto">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                    <span class="small fw-bold text-dark">Nhận xét của Giáo viên Chủ nhiệm</span>
                </div>
                <p class="small text-muted mb-0">
                    "Em chăm ngoan, có tinh thần tự học cao và hòa đồng với bạn bè. Cần duy trì phong độ và luyện thêm bài tập Hóa học nâng cao."
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     4. BOTTOM ROW: HOMEWORK & QUICK ACTIONS
     ========================================== -->
<div class="row g-4">
    <!-- Pending Homework -->
    <div class="col-12 col-lg-7">
        <div class="dash-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="dash-card-title mb-0">Bài Tập & Nhiệm Vụ Cần Hoàn Thành</h2>
                <a href="#homework" class="text-primary text-decoration-none small fw-semibold">Xem tất cả</a>
            </div>

            <div class="announcement-item">
                <div class="announcement-badge badge-blue">Toán học</div>
                <div class="announcement-content">
                    <div class="announcement-title">Bài tập trắc nghiệm chương Khảo sát hàm số (Trang 45 SGK)</div>
                    <div class="announcement-date text-danger"><i class="bi bi-clock-history me-1"></i>Hạn nộp: 23:59 ngày mai</div>
                </div>
            </div>

            <div class="announcement-item">
                <div class="announcement-badge badge-green">Tiếng Anh</div>
                <div class="announcement-content">
                    <div class="announcement-title">Viết bài luận ngắn 150 từ về chủ đề Environmental Protection</div>
                    <div class="announcement-date"><i class="bi bi-calendar3 me-1"></i>Hạn nộp: Thứ Sáu, ngày 01/11/2024</div>
                </div>
            </div>

            <div class="announcement-item">
                <div class="announcement-badge badge-amber">Vật lý</div>
                <div class="announcement-content">
                    <div class="announcement-title">Chuẩn bị bài thí nghiệm đo gia tốc trọng trường</div>
                    <div class="announcement-date"><i class="bi bi-calendar3 me-1"></i>Hạn nộp: Thứ Hai tuần sau</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions (Student) -->
    <div class="col-12 col-lg-5">
        <div class="dash-card h-100">
            <h2 class="dash-card-title mb-3">Thao Tác Nhanh</h2>
            <div class="row g-2">
                <div class="col-6">
                    <a href="#scores" class="quick-action-btn">
                        <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                        <span>Xem Sổ Điểm</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="#timetable" class="quick-action-btn">
                        <i class="bi bi-calendar-week-fill"></i>
                        <span>Thời Khóa Biểu</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="#leave-request" class="quick-action-btn">
                        <i class="bi bi-envelope-paper-fill"></i>
                        <span>Xin Nghỉ Phép</span>
                    </a>
                </div>
                <div class="col-6">
                    <a href="#ask-teacher" class="quick-action-btn">
                        <i class="bi bi-question-circle-fill"></i>
                        <span>Hỏi Giáo Viên</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
