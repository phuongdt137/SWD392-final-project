@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using HSMS.MVC.DTOs.Auth
@inject HSMS.MVC.Service.INotificationService Notifications
@{
    LoginResponseDto? currentUser = null;
    try
    {
        var userJson = Context.Session.GetString("CurrentUser");
        if (!string.IsNullOrEmpty(userJson))
        {
            currentUser = JsonSerializer.Deserialize<LoginResponseDto>(userJson);
        }
    }
    catch { }

    var displayName = currentUser?.FullName ?? currentUser?.Username ?? "User";
    var primaryRole = (currentUser?.Roles?.FirstOrDefault() ?? "STAFF").ToUpper();
    var roleDisplayName = primaryRole switch
    {
        "PRINCIPAL" => "Hiệu trưởng",
        "STAFF" => "Nhân viên học vụ",
        "TEACHER" => "Giáo viên",
        "STUDENT" => "Học sinh",
        "PARENT" => "Phụ huynh",
        _ => primaryRole
    };

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var isDashboardPage = string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase);
    var isAttendancePage = string.Equals(currentController, "Attendance", StringComparison.OrdinalIgnoreCase);
    // Chuông được render cùng trang; không polling, không SignalR và không bật pop-up tự động.
    var unreadNotifications = await Notifications.UnreadCountAsync(Context.RequestAborted);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - High School Management System</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Dashboard CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/attendance.css" asp-append-version="true" />
</head>
<body class="dashboard-body-tag">
    <div class="dashboard-wrapper">
        <!-- ==================== SIDEBAR ==================== -->
        <aside class="dashboard-sidebar" id="dashboardSidebar">
            <!-- Brand -->
            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div class="sidebar-brand-text">
                    High School<br>Management System
                </div>
            </a>

            <!-- Navigation Menu by Role -->
            <nav class="sidebar-nav">
                @if (primaryRole is "ADMIN" or "PRINCIPAL")
                {
                    <a asp-controller="Attendance" asp-action="Index" class="sidebar-link @(isAttendancePage ? "active" : "")"><i class="bi bi-calendar-check"></i><span>Điểm danh</span></a>
                }
                @if (primaryRole == "PRINCIPAL")
                {
                    <a asp-controller="Dashboard" asp-action="Principal" class="sidebar-link @(currentController == "Dashboard" && (currentAction == "Principal" || currentAction == "Index") ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Điều hành (Principal)</span>
                    </a>
                    <a href="#approvals" class="sidebar-link">
                        <i class="bi bi-file-earmark-check-fill"></i>
                        <span>Phê duyệt & Tờ trình</span>
                        <span class="sidebar-badge">5</span>
                    </a>
                    <a href="#academic-oversight" class="sidebar-link">
                        <i class="bi bi-mortarboard"></i>
                        <span>Giám sát Đào tạo</span>
                    </a>
                    <a href="#staff-directory" class="sidebar-link">
                        <i class="bi bi-person-workspace"></i>
                        <span>Nhân sự & Giáo viên</span>
                    </a>
                    <a href="#student-quality" class="sidebar-link">
                        <i class="bi bi-people-fill"></i>
                        <span>Chất lượng Học sinh</span>
                    </a>
                    <a href="#executive-reports" class="sidebar-link">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Thống kê Chiến lược</span>
                    </a>
                    <a href="#school-directives" class="sidebar-link">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Chỉ đạo Ban Giám Hiệu</span>
                    </a>
                    <a href="#school-policies" class="sidebar-link">
                        <i class="bi bi-shield-check"></i>
                        <span>Quy chế & Cấu hình</span>
                    </a>
                }
                else if (primaryRole == "STAFF")
                {
                    <a asp-controller="Dashboard" asp-action="Staff" class="sidebar-link @(isDashboardPage ? "active" : "")" aria-current="@(isDashboardPage ? "page" : null)">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Tổng quan (Staff)</span>
                    </a>
                    <a asp-controller="Attendance" asp-action="Index" class="sidebar-link @(isAttendancePage ? "active" : "")" aria-current="@(isAttendancePage ? "page" : null)">
                        <i class="bi bi-calendar-check"></i>
                        <span>Điểm danh</span>
                    </a>
                    <a href="#students" class="sidebar-link">
                        <i class="bi bi-people-fill"></i>
                        <span>Quản lý Học sinh</span>
                    </a>
                    <a href="#teachers" class="sidebar-link">
                        <i class="bi bi-person-badge"></i>
                        <span>Quản lý Giáo viên</span>
                    </a>
                    <a href="#classes" class="sidebar-link">
                        <i class="bi bi-building"></i>
                        <span>Lớp học & Khối</span>
                    </a>
                    <a href="#subjects" class="sidebar-link">
                        <i class="bi bi-journal-bookmark-fill"></i>
                        <span>Môn học</span>
                    </a>
                    <a href="#timetable" class="sidebar-link">
                        <i class="bi bi-calendar3"></i>
                        <span>Thời khóa biểu</span>
                    </a>
                    <a href="#reports" class="sidebar-link">
                        <i class="bi bi-bar-chart-line-fill"></i>
                        <span>Báo cáo & Thống kê</span>
                    </a>
                    <a href="#settings" class="sidebar-link">
                        <i class="bi bi-gear-fill"></i>
                        <span>Cấu hình Năm học</span>
                    </a>
                }
                else if (primaryRole == "TEACHER")
                {
                    <a asp-controller="Dashboard" asp-action="Teacher" class="sidebar-link @(currentController == "Dashboard" && (currentAction == "Teacher" || currentAction == "Index") ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#classes" class="sidebar-link">
                        <i class="bi bi-people-fill"></i>
                        <span>Lớp của tôi</span>
                    </a>
                    <a href="#students" class="sidebar-link">
                        <i class="bi bi-person-badge"></i>
                        <span>Học sinh</span>
                    </a>
                    <a asp-controller="Attendance" asp-action="Index" class="sidebar-link @(currentController == "Attendance" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>Điểm danh</span>
                    </a>
                    <a asp-controller="Score" asp-action="Index" class="sidebar-link @(currentController == "Score" ? "active" : "")">
                        <i class="bi bi-card-checklist"></i>
                        <span>Sổ điểm</span>
                    </a>
                    <a asp-controller="Score" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-journal-text"></i>
                        <span>Bài tập & Đánh giá</span>
                    </a>
                    <a href="#schedule" class="sidebar-link">
                        <i class="bi bi-calendar3"></i>
                        <span>Lịch dạy</span>
                    </a>
                    <a href="#messages" class="sidebar-link">
                        <i class="bi bi-chat-dots-fill"></i>
                        <span>Tin nhắn</span>
                        <span class="sidebar-badge">3</span>
                    </a>
                    <a href="#leaves" class="sidebar-link">
                        <i class="bi bi-envelope-paper"></i>
                        <span>Đơn xin nghỉ phép</span>
                    </a>
                }
                else if (primaryRole == "STUDENT")
                {
                    <a asp-controller="Dashboard" asp-action="Student" class="sidebar-link @(currentController == "Dashboard" && (currentAction == "Student" || currentAction == "Index") ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#timetable" class="sidebar-link">
                        <i class="bi bi-calendar3"></i>
                        <span>Thời khóa biểu</span>
                    </a>
                    <a asp-controller="Score" asp-action="MyScores" class="sidebar-link @(currentController == "Score" ? "active" : "")">
                        <i class="bi bi-award-fill"></i>
                        <span>Bảng điểm & Học tập</span>
                    </a>
                    <a asp-controller="Attendance" asp-action="Index" class="sidebar-link @(currentController == "Attendance" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>Điểm danh cá nhân</span>
                    </a>
                    <a href="#conduct" class="sidebar-link">
                        <i class="bi bi-star-fill"></i>
                        <span>Đánh giá rèn luyện</span>
                    </a>
                    <a href="#leaves" class="sidebar-link">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Đơn xin nghỉ</span>
                    </a>
                    <a href="#notifications" class="sidebar-link">
                        <i class="bi bi-bell-fill"></i>
                        <span>Thông báo lớp</span>
                        <span class="sidebar-badge">2</span>
                    </a>
                }
                else if (primaryRole == "PARENT")
                {
                    <a asp-controller="Dashboard" asp-action="Parent" class="sidebar-link @(currentController == "Dashboard" && (currentAction == "Parent" || currentAction == "Index") ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#children" class="sidebar-link">
                        <i class="bi bi-person-hearts"></i>
                        <span>Hồ sơ con cái</span>
                    </a>
                    <a asp-controller="Score" asp-action="MyScores" class="sidebar-link @(currentController == "Score" ? "active" : "")">
                        <i class="bi bi-award-fill"></i>
                        <span>Kết quả học tập</span>
                    </a>
                    <a asp-controller="Attendance" asp-action="Index" class="sidebar-link @(currentController == "Attendance" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>Chuyên cần hàng ngày</span>
                    </a>
                    <a href="#leave-request" class="sidebar-link">
                        <i class="bi bi-envelope-paper"></i>
                        <span>Đơn xin nghỉ phép</span>
                    </a>
                    <a href="#messages" class="sidebar-link">
                        <i class="bi bi-chat-dots-fill"></i>
                        <span>Liên lạc GVCN</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(isDashboardPage ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                }
            </nav>

            <!-- Bottom Motivation Banner -->
            <div class="sidebar-footer-widget">
                <div class="sidebar-quote-box">
                    <div class="sidebar-quote-text">Support Students<br>Build Brighter Tomorrows. ↗</div>
                </div>
            </div>
        </aside>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <div class="dashboard-main">
            <!-- Top Header Bar -->
            <header class="dashboard-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Toggle Sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topbar-search-wrap">
                        <i class="bi bi-search topbar-search-icon"></i>
                        <input type="text" class="topbar-search-input" placeholder="Tìm kiếm học sinh, lớp học, giáo viên..." />
                    </div>
                </div>

                <div class="topbar-right">
                    <!-- Notifications -->
                    <a asp-controller="Notifications" asp-action="Index" class="notification-btn" title="Thông báo" aria-label="Thông báo">
                        <i class="bi bi-bell"></i>
                        <span id="notification-count" class="notification-badge-dot" hidden="@(unreadNotifications == 0)">@(unreadNotifications > 99 ? "99+" : unreadNotifications.ToString())</span>
                    </a>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <button class="user-profile-btn dropdown-toggle" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-circle">
                                @if (!string.IsNullOrWhiteSpace(currentUser?.AvatarUrl))
                                {
                                    <img src="@currentUser.AvatarUrl" alt="Avatar" />
                                }
                                else
                                {
                                    <span>@displayName.Substring(0, 1).ToUpper()</span>
                                }
                            </div>
                            <div class="user-info-text d-none d-sm-block">
                                <div class="user-name">@displayName</div>
                                <div class="user-role">@roleDisplayName</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="userMenuButton" style="min-width: 230px;">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold text-dark text-truncate">@displayName</div>
                                <div class="small text-muted text-truncate">@(currentUser?.Email ?? "")</div>
                                <span class="badge bg-primary-subtle text-primary mt-1">@roleDisplayName</span>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Auth" asp-action="ChangePassword">
                                    <i class="bi bi-key text-muted"></i>
                                    <span>Đổi mật khẩu</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Đăng xuất</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Page Content -->
            <main class="dashboard-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar Toggle for Mobile / Responsive
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('dashboardSidebar');
        if (sidebarToggle && sidebar) {
            sidebarToggle.addEventListener('click', () => {
                sidebar.classList.toggle('show');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
