@* Partial chung; PageUrl do trang gọi truyền vào để giữ bộ lọc. *@
@model HSMS.MVC.ViewModels.Attendance.AttendancePagination
@{
    // Luôn có trang đầu/cuối; tối đa 7 trang hiện hết, nhiều hơn thì lấy cửa sổ 5 trang gần trang chọn.
    var visiblePages = new SortedSet<int> { 1, Model.Pages };
    var firstVisible = Model.Pages <= 7 ? 1 : Math.Max(1, Math.Min(Model.Page - 2, Model.Pages - 4));
    var lastVisible = Model.Pages <= 7 ? Model.Pages : Math.Min(Model.Pages, firstVisible + 4);
    for (var number = firstVisible; number <= lastVisible; number++) visiblePages.Add(number);
}
<nav aria-label="Phân trang điểm danh">
    <ul class="pagination pagination-sm mb-0 review-page-numbers">
        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
            @if (Model.Page > 1) { <a class="page-link" href="@Model.PageUrl(1)" aria-label="Trang đầu" title="Trang đầu">«</a> }
            else { <span class="page-link" aria-disabled="true" aria-label="Trang đầu">«</span> }
        </li>
        <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
            @if (Model.Page > 1) { <a class="page-link" href="@Model.PageUrl(Model.Page - 1)" aria-label="Trang trước" title="Trang trước" rel="prev">‹</a> }
            else { <span class="page-link" aria-disabled="true" aria-label="Trang trước">‹</span> }
        </li>
        @{ var previousPage = 0; }
        @foreach (var number in visiblePages)
        {
            @* Chèn dấu ... khi có khoảng trang bị lược, tránh hiển thị hàng trăm nút. *@
            @if (previousPage > 0 && number - previousPage > 1)
            {
                <li class="page-item disabled review-page-gap"><span class="page-link" aria-hidden="true">…</span><span class="visually-hidden">Các trang ở giữa</span></li>
            }
            // CSS ẩn bớt trang xa trên điện thoại; trang đầu/cuối luôn giữ lại.
            var compactHidden = Model.Pages > 7 && number != 1 && number != Model.Pages && Math.Abs(number - Model.Page) > 1;
            <li class="page-item @(number == Model.Page ? "active" : "") @(compactHidden ? "review-page-distant" : "")">
                @if (number == Model.Page) { <span class="page-link" aria-current="page">@number</span> }
                else { <a class="page-link" href="@Model.PageUrl(number)" aria-label="Trang @number">@number</a> }
            </li>
            previousPage = number;
        }
        <li class="page-item @(Model.Page == Model.Pages ? "disabled" : "")">
            @if (Model.Page < Model.Pages) { <a class="page-link" href="@Model.PageUrl(Model.Page + 1)" aria-label="Trang sau" title="Trang sau" rel="next">›</a> }
            else { <span class="page-link" aria-disabled="true" aria-label="Trang sau">›</span> }
        </li>
        <li class="page-item @(Model.Page == Model.Pages ? "disabled" : "")">
            @if (Model.Page < Model.Pages) { <a class="page-link" href="@Model.PageUrl(Model.Pages)" aria-label="Trang cuối" title="Trang cuối">»</a> }
            else { <span class="page-link" aria-disabled="true" aria-label="Trang cuối">»</span> }
        </li>
    </ul>
</nav>
