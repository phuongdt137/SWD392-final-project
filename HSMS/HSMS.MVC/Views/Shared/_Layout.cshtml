@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using HSMS.MVC.DTOs.Auth
@{
    var currentUser = Context.Session.GetCurrentUser();
    var isAuthenticated = currentUser != null;
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser.FullName : currentUser?.Username;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - High School Management System</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HSMS.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Main Top Navbar -->
    <header class="main-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- Brand -->
            <a class="brand-logo" asp-controller="Home" asp-action="Index">
                <svg class="brand-icon" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 19.94 8.13 22 12 22C15.87 22 19 19.94 19 17.18V13.18L12 17L5 13.18Z"/>
                </svg>
                <span>High School Management System</span>
            </a>

            <!-- Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-1">
                <a class="nav-link-custom active" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link-custom" href="/#features">Features</a>
                <a class="nav-link-custom" href="/#about">About</a>
                <a class="nav-link-custom" href="/#contact">Contact</a>
                @if (isAuthenticated)
                {
                    <a class="nav-link-custom text-primary fw-semibold" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                }
            </nav>

            <!-- Right Controls: Search & Login -->
            <div class="d-flex align-items-center gap-3">
                <div class="search-input-wrap d-none d-lg-block">
                    <i class="bi bi-search"></i>
                    <input type="text" class="search-input" placeholder="Search..." aria-label="Search" />
                </div>
                @if (isAuthenticated && currentUser != null)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1 bg-white border shadow-sm" 
                                type="button" 
                                id="userProfileDropdown" 
                                data-bs-toggle="dropdown" 
                                aria-expanded="false">
                            <i class="bi bi-person-circle text-primary fs-5"></i>
                            <span class="fw-semibold text-dark small">@displayName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="userProfileDropdown" style="min-width: 220px;">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold text-dark text-truncate">@displayName</div>
                                <div class="small text-muted text-truncate">@currentUser.Email</div>
                                @if (currentUser.Roles.Count > 0)
                                {
                                    <span class="badge bg-primary-subtle text-primary mt-1">@string.Join(", ", currentUser.Roles)</span>
                                }
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 text-primary"></i>
                                    <span>Bảng điều khiển</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Auth" asp-action="ChangePassword">
                                    <i class="bi bi-key text-muted"></i>
                                    <span>Đổi mật khẩu</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Đăng xuất</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="btn-login-nav">
                        <i class="bi bi-person-fill"></i>
                        <span>Login</span>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Sleek Dark Footer -->
    <footer class="main-footer" id="contact">
        <div class="container">
            <div class="footer-top">
                <div>
                    <a class="footer-brand" asp-controller="Home" asp-action="Index">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="#3B82F6">
                            <path d="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18C5 19.94 8.13 22 12 22C15.87 22 19 19.94 19 17.18V13.18L12 17L5 13.18Z"/>
                        </svg>
                        <span>High School Management System</span>
                    </a>
                    <div class="footer-tagline">Empowering Schools. Building Brighter Futures.</div>
                </div>

                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a href="/#features">Features</a></li>
                    <li><a href="/#about">About</a></li>
                    <li><a href="/#contact">Contact</a></li>
                </ul>
            </div>

            <div class="footer-bottom">
                <div class="social-links">
                    <a href="#" class="social-link" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-link" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="social-link" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="#" class="social-link" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                </div>
                <div>
                    &copy; 2024 High School Management System. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

