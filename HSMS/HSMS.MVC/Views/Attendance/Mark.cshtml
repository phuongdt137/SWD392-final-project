@model AttendanceSheetViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bảng điểm danh";
    var assignment = Model.Entry.TeachingAssignment;
    var inputIndex = 0;
    var editableRows = Model.Students.Where(s => Model.StaffMode ? s.Record != null : s.InRoster).ToList();
}
<link rel="stylesheet" href="~/css/attendance-module.css" asp-append-version="true" />
<div class="attendance-module">
    <div class="am-heading">
        <div><h1>@assignment.Class.ClassName — @assignment.Subject.SubjectName</h1>
            <p>@Model.Date.ToString("dd/MM/yyyy") · Tiết @Model.Entry.TimeSlot.PeriodNo · @Model.Entry.Room.RoomName · @assignment.Semester.SemesterName</p>
        </div>
        <a asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Về lịch</a>
    </div>
    @if (TempData["AttendanceSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["AttendanceWarning"] is string warning) { <div class="alert alert-warning" role="status">@warning</div> }
    @if (!Model.CanWrite)
    {
        <div class="alert alert-info">@Model.ReadOnlyReason</div>
    }
    else
    {
        <div class="alert alert-info">
            @if (Model.StaffMode) { <span>Staff chỉ sửa kết quả đã có. Khóa sửa khi hết học kỳ: </span> }
            else { <span>Giáo viên được ghi/sửa đến trước </span> }
            <strong>@SchoolTime.Local(Model.DeadlineUtc).ToString("dd/MM/yyyy HH:mm")</strong> (giờ Việt Nam).
        </div>
    }
    <div id="attendance-expired" class="alert alert-warning d-none" role="status">Đã đến hạn khóa. Bạn chỉ có thể xem bảng điểm danh.</div>
    <form asp-action="Save" method="post" id="attendance-form" data-deadline="@Model.DeadlineUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <input type="hidden" name="TimetableEntryId" value="@Model.Entry.Id" />
        <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
        <div class="card table-responsive"><table class="table align-middle am-sheet mb-0">
            <thead><tr><th>Học sinh</th><th>Trạng thái</th><th>Đơn nghỉ đã duyệt</th><th>Ghi chú</th>@if (Model.CanViewAudit) { <th>Nhật ký</th> }</tr></thead>
            <tbody>
            @foreach (var row in Model.Students)
            {
                var editable = Model.CanWrite && (Model.StaffMode ? row.Record != null : row.InRoster);
                var attempted = Model.Attempt?.Rows.FirstOrDefault(r => r.CustomerId == row.Student.Id);
                var status = attempted?.Status ?? row.Record?.Status;
                var comment = attempted?.Comment ?? row.Record?.Comment;
                var leaveId = attempted == null ? row.Record?.LeaveRequestId : attempted.LeaveRequestId;
                var approvedLeave = row.Leaves.FirstOrDefault(l => l.Id == leaveId) ?? row.Leaves.FirstOrDefault();
                if (approvedLeave != null)
                {
                    status = AttendanceStatuses.Excused;
                    leaveId = approvedLeave.Id;
                }
                <tr data-recorded="@(row.Record != null ? "true" : "false")" data-status="@row.Record?.Status"
                    data-comment="@row.Record?.Comment" data-leave="@row.Record?.LeaveRequestId">
                    <td><strong>@row.Student.FullName</strong><br /><small>@row.Student.StudentCode</small>
                        @if (!row.InRoster) { <small class="d-block text-muted">Không còn trong danh sách lớp ngày này</small> }
                    </td>
                    @if (editable)
                    {
                        var i = inputIndex++;
                        <td>
                            <input type="hidden" name="Rows[@i].CustomerId" value="@row.Student.Id" />
                            <select name="Rows[@i].Status" class="form-select am-status" aria-label="Trạng thái của @row.Student.FullName" required>
                                @if (approvedLeave == null) { <option value="">Chọn trạng thái</option> }
                                @foreach (var code in AttendanceStatuses.All)
                                {
                                    if (approvedLeave == null || code == AttendanceStatuses.Excused)
                                    {
                                        <option value="@code" selected="@(status == code)">@AttendanceStatuses.Label(code)</option>
                                    }
                                }
                            </select>
                        </td>
                        <td><select name="Rows[@i].LeaveRequestId" class="form-select am-leave" aria-label="Đơn nghỉ của @row.Student.FullName">
                            @if (approvedLeave == null) { <option value="">Không chọn đơn</option> }
                            @foreach (var leave in row.Leaves) { <option value="@leave.Id" selected="@(leaveId == leave.Id)">#@leave.Id — @leave.Reason</option> }
                        </select>
                            @if (approvedLeave != null) { <small class="text-muted">Tự động theo đơn nghỉ đã duyệt.</small> }
                        </td>
                        <td><input name="Rows[@i].Comment" value="@comment" maxlength="1000" class="form-control am-comment" aria-label="Ghi chú của @row.Student.FullName" /></td>
                    }
                    else
                    {
                        <td>@AttendanceStatuses.Label(row.Record?.Status)
                            @if (Model.StaffMode && row.Record == null) { <small class="d-block text-muted">Staff không được điểm danh lần đầu</small> }
                        </td>
                        <td>@(row.Record?.LeaveRequestId.HasValue == true ? "Đơn #" + row.Record.LeaveRequestId : "—")</td>
                        <td>@(row.Record?.Comment ?? "—")</td>
                    }
                    @if (Model.CanViewAudit) { <td>@if (row.Record != null) { <a asp-action="Audit" asp-route-id="@row.Record.Id">Nhật ký</a> }</td> }
                </tr>
            }
            @if (Model.Students.Count == 0) { <tr><td colspan="@(Model.CanViewAudit ? 5 : 4)">Chưa có học sinh hoặc kết quả điểm danh.</td></tr> }
            </tbody>
        </table></div>
        @if (Model.CanWrite && editableRows.Count > 0)
        {
            <div class="card p-3 my-3">
                <label for="reason" class="form-label">Lý do chỉnh sửa <span class="text-muted">(bắt buộc nếu thay đổi kết quả đã có)</span></label>
                <textarea id="reason" name="ChangeReason" maxlength="1000" class="form-control" rows="2">@Model.Attempt?.ChangeReason</textarea>
            </div>
            <button class="btn btn-primary" type="submit" id="attendance-save">Lưu điểm danh</button>
            <p class="text-muted small mt-3">Đi muộn/vắng không phép sẽ tạo thông báo và email cho phụ huynh hợp lệ sau khi lưu thành công.</p>
        }
    </form>
</div>
@section Scripts { <script src="~/js/attendance.js" asp-append-version="true"></script> }
