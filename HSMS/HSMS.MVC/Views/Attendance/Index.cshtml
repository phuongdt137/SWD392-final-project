@model AttendanceIndexViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Lịch điểm danh";
    var filter = Model.Filter;
}
<link rel="stylesheet" href="~/css/attendance-module.css" asp-append-version="true" />
<div class="attendance-module">
    <div class="am-heading">
        <div><h1>Lịch điểm danh</h1>
            @if (Model.CanFilter)
            {
                <p>Chọn ngày và tiết học để xem hoặc ghi nhận kết quả.</p>
            }
            else
            {
                <p>Các tiết được phân công hôm nay, ngày <strong>@filter.Date?.ToString("dd/MM/yyyy")</strong>.</p>
            }
        </div>
        @if (Model.CanViewHistory) { <a asp-action="History" class="btn btn-outline-primary">Xem lịch sử</a> }
    </div>
    @if (Model.CanFilter)
    {
        <form method="get" class="am-filters card p-3 mb-4">
            <div><label for="date">Ngày học</label><input id="date" name="Date" type="date" class="form-control" value="@filter.Date?.ToString("yyyy-MM-dd")" required /></div>
            <div><label for="class">Lớp</label><select id="class" name="ClassId" class="form-select">
                <option value="">Tất cả lớp được phép xem</option>
                @foreach (var item in Model.Classes) { <option value="@item.Id" selected="@(filter.ClassId == item.Id)">@item.Name</option> }
            </select></div>
            <button class="btn btn-primary">Xem lịch</button>
        </form>
    }
    <p class="text-muted">@Model.Total tiết học · Trang @filter.Page / @Model.Pages</p>
    @if (Model.Lessons.Count == 0)
    {
        <div class="card p-4">@(Model.CanFilter
            ? "Không có tiết học phù hợp. Hãy kiểm tra ngày, lớp hoặc phân công giảng dạy hiện có."
            : "Hôm nay bạn không có tiết học được phân công.")</div>
    }
    else
    {
        <div class="card table-responsive"><table class="table align-middle mb-0">
            <thead><tr><th>Tiết / giờ học</th><th>Lớp / môn</th><th>Giáo viên</th><th>Kết quả</th><th></th></tr></thead>
            <tbody>
            @foreach (var lesson in Model.Lessons)
            {
                var entry = lesson.Entry;
                <tr>
                    <td>Tiết @entry.TimeSlot.PeriodNo<br /><small>@entry.TimeSlot.StartTime.ToString(@"hh\:mm") – @entry.TimeSlot.EndTime.ToString(@"hh\:mm")</small></td>
                    <td><strong>@entry.TeachingAssignment.Class.ClassName</strong><br />@entry.TeachingAssignment.Subject.SubjectName</td>
                    <td>@entry.TeachingAssignment.Employee.FullName</td>
                    <td>@lesson.Recorded / @lesson.Students học sinh<br /><small>@(lesson.Recorded == 0 ? "Chưa ghi nhận" : "Đã có kết quả")</small></td>
                    <td><a asp-action="Mark" asp-route-timetableEntryId="@entry.Id" asp-route-date="@filter.Date?.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">Mở bảng</a></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
    <nav class="am-pagination" aria-label="Phân trang lịch điểm danh">
        @if (filter.Page > 1) { <a asp-action="Index" asp-route-date="@(Model.CanFilter ? filter.Date?.ToString("yyyy-MM-dd") : null)" asp-route-classId="@filter.ClassId" asp-route-page="@(filter.Page - 1)" class="btn btn-outline-secondary">Trang trước</a> }
        @if (filter.Page < Model.Pages) { <a asp-action="Index" asp-route-date="@(Model.CanFilter ? filter.Date?.ToString("yyyy-MM-dd") : null)" asp-route-classId="@filter.ClassId" asp-route-page="@(filter.Page + 1)" class="btn btn-outline-secondary">Trang sau</a> }
    </nav>
</div>
