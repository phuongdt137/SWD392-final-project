@model AttendanceAuditViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Nhật ký điểm danh";
}
<link rel="stylesheet" href="~/css/attendance-module.css" asp-append-version="true" />
<div class="attendance-module">
    <div class="am-heading">
        <div><h1>Nhật ký điểm danh</h1><p>@Model.Record.Customer.FullName · @Model.Record.AttendanceDate.ToString("dd/MM/yyyy") · @Model.Record.TimetableEntry.TeachingAssignment.Subject.SubjectName</p></div>
        <a asp-action="Mark" asp-route-timetableEntryId="@Model.Record.TimetableEntryId" asp-route-date="@Model.Record.AttendanceDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Về bảng</a>
    </div>
    <div class="card table-responsive"><table class="table align-middle mb-0">
        <thead><tr><th>Thời gian</th><th>Người thực hiện</th><th>Trạng thái trước → sau</th><th>Ghi chú trước → sau</th><th>Đơn nghỉ trước → sau</th><th>Lý do</th></tr></thead>
        <tbody>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td>@SchoolTime.Local(log.ChangedAt).ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@log.ChangedByEmployee.FullName</td>
                <td>@AttendanceStatuses.Label(log.OldStatus) → @AttendanceStatuses.Label(log.NewStatus)</td>
                <td>@(log.OldComment ?? "—") → @(log.NewComment ?? "—")</td>
                <td>@(log.OldLeaveRequestId?.ToString() ?? "—") → @(log.NewLeaveRequestId?.ToString() ?? "—")</td>
                <td>@(log.ChangeReason ?? "Ghi nhận lần đầu")</td>
            </tr>
        }
        @if (Model.Logs.Count == 0) { <tr><td colspan="6">Kết quả chưa có nhật ký được lưu.</td></tr> }
        </tbody>
    </table></div>
</div>
