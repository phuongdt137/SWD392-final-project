 @model List<HSMS.MVC.DTOs.Academic.SubjectListItemDto>
@{
    ViewData["Title"] = "Môn học - High School Management System";
    Layout = "_DashboardLayout";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="welcome-title h3 mb-0">Môn học</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm môn học</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã môn</th>
                    <th>Tên môn học</th>
                    <th>Hình thức đánh giá</th>
                    <th class="text-center">Số phân công</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.SubjectCode</td>
                        <td>@s.SubjectName</td>
                        <td>@s.EvaluationType</td>
                        <td class="text-center">@s.AssignmentCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Xóa môn học này?');">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>