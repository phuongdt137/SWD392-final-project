@using HSMS.MVC.Common
@* Hộp thông báo lưu ở database, phụ huynh offline có thể xem lại khi đăng nhập. *@
@model HSMS.MVC.DTOs.Notifications.NotificationFeed
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Thông báo"; }
<div class="attendance-page"><h1 class="h3 fw-bold">Thông báo của tôi</h1><p class="text-muted">@Model.Unread thông báo chưa đọc. Hiển thị 100 thông báo gần nhất.</p>
@if (Model.Items.Count == 0) { <div class="card p-4">Chưa có thông báo.</div> }
@foreach (var item in Model.Items) {
    <article class="card p-3 mb-3 @(item.IsRead ? "" : "border-primary")">
        <div class="d-flex justify-content-between gap-3"><h2 class="h6 fw-bold">@item.Title</h2><small>@SchoolTime.Local(item.SentAt).ToString("dd/MM/yyyy HH:mm")</small></div>
        <p>@item.Content</p><div class="d-flex gap-3 align-items-center">
            @* Chỉ mở link nội bộ; đọc thông báo trong ứng dụng độc lập với trạng thái email. *@
            @if (!string.IsNullOrEmpty(item.Link) && Url.IsLocalUrl(item.Link)) { <a href="@item.Link">Xem chuyên cần</a> }
            @if (!item.IsRead) { <form asp-action="Read" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-primary">Đánh dấu đã đọc</button></form> }
        </div>
        @if (item.EmailStatus != null)
        {
            var emailLabel = item.EmailStatus switch
            {
                "SENT" => "Đã gửi email",
                "SENDING" => "Đang gửi email",
                "FAILED" => "Email chưa gửi thành công",
                _ => "Email đang chờ gửi"
            };
            <small class="text-muted mt-2">@emailLabel</small>
        }
    </article>
}
</div>
