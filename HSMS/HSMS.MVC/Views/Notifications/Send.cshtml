@model HSMS.MVC.DTOs.Notifications.SendNotificationRequest
@using HSMS.MVC.DTOs.Notifications
@{ Layout = "_DashboardLayout"; ViewData["Title"] = "Gửi thông báo"; var classes = ViewBag.Classes as IReadOnlyList<NotificationClassOption> ?? Array.Empty<NotificationClassOption>(); }
<div class="attendance-page">
    <div class="mb-4"><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Quay lại hộp thư</a><h1 class="h3 fw-bold mt-3">Gửi thông báo</h1><p class="text-muted">Gửi thông báo chính thức đến toàn trường, một vai trò hoặc một lớp.</p></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    <form asp-action="Send" method="post" class="card p-4" style="max-width:760px">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="TargetType" class="form-label">Nhóm người nhận</label>
            <select asp-for="TargetType" class="form-select" id="targetType"><option value="ALL">Toàn trường</option><option value="ROLE">Theo vai trò</option><option value="CLASS">Theo lớp</option></select>
        </div>
        <div class="mb-3" id="roleTarget"><label asp-for="RoleCode" class="form-label">Vai trò</label><select asp-for="RoleCode" class="form-select"><option value="">Chọn vai trò</option><option value="STUDENT">Học sinh</option><option value="PARENT">Phụ huynh</option><option value="TEACHER">Giáo viên</option><option value="PRINCIPAL">Ban giám hiệu</option><option value="STAFF">Nhân viên</option></select></div>
        <div class="mb-3" id="classTarget"><label asp-for="ClassId" class="form-label">Lớp</label><select asp-for="ClassId" class="form-select"><option value="">Chọn lớp</option>@foreach (var item in classes) { <option value="@item.Id">@item.Name</option> }</select><div class="form-text">Thông báo gửi đến học sinh đang trong lớp và phụ huynh được liên kết.</div></div>
        <div class="mb-3"><label asp-for="Title" class="form-label">Tiêu đề</label><input asp-for="Title" class="form-control" maxlength="200" required /><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="Content" class="form-label">Nội dung</label><textarea asp-for="Content" class="form-control" rows="6" maxlength="4000" required></textarea><span asp-validation-for="Content" class="text-danger"></span></div>
        <div><button class="btn btn-primary" type="submit"><i class="bi bi-send"></i> Gửi thông báo</button></div>
    </form>
</div>
<script>
(() => {
    const target = document.getElementById('targetType');
    const role = document.getElementById('roleTarget');
    const classroom = document.getElementById('classTarget');
    function update() {
        role.hidden = target.value !== 'ROLE';
        classroom.hidden = target.value !== 'CLASS';
    }
    target.addEventListener('change', update);
    update();
})();
</script>
