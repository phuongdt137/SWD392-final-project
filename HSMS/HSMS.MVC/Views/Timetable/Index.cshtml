@model HSMS.MVC.ViewModels.StaffTimetableViewModel
@{
    ViewData["Title"] = "Thời khóa biểu";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Thời khóa biểu (Staff)</h2>
    <a asp-action="Create" class="btn btn-primary">+ Tạo lịch dạy</a>
</div>

<form method="get" class="row g-2 mb-4">
<div class="col-md-3"><label for="week">Ngày trong tuần cần xem</label><input id="week" name="week" type="date" value="@Model.Timetable.WeekStart.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-4">
        <select name="classId" class="form-select">
            <option value="">-- Tất cả lớp --</option>
            @foreach (var o in Model.Options.Classes)
            {
                <option value="@o.Id" selected="@(o.Id == Model.ClassId)">@o.Text</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <select name="employeeId" class="form-select">
            <option value="">-- Tất cả giáo viên --</option>
            @foreach (var o in Model.Options.Employees)
            {
                <option value="@o.Id" selected="@(o.Id == Model.EmployeeId)">@o.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-secondary">Lọc</button>
    </div>
</form>

@await Html.PartialAsync("_WeeklyGrid", Model.Timetable)

