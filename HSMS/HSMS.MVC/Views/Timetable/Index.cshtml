@model HSMS.MVC.ViewModels.Timetable.TimetableIndexViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.DisplayTitle + " - High School Management System";
}

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm rounded-3" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div><strong>Thành công!</strong> @successMsg</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div><strong>Lỗi!</strong> @errorMsg</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-calendar3 me-2 text-primary"></i>@Model.DisplayTitle
        </h1>
        <p class="text-muted mb-0">@Model.Subtitle</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.CanCreate)
        {
            <a asp-action="Create" 
               asp-route-classId="@Model.SelectedClassId" 
               asp-route-semesterId="@Model.SelectedSemesterId" 
               class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3">
                <i class="bi bi-plus-circle-fill"></i>
                <span class="fw-semibold">Đặt lịch dạy mới</span>
            </a>
        }
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 rounded-3">
            <i class="bi bi-printer"></i>
            <span>In lịch</span>
        </button>
    </div>
</div>

<!-- Filters Section -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <!-- Học kỳ -->
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="SemesterId" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-clock-history me-1"></i>Học kỳ
                </label>
                <select name="SemesterId" id="SemesterId" class="form-select rounded-3">
                    @foreach (var sem in Model.Semesters)
                    {
                        <option value="@sem.Value" selected="@(sem.Selected ? "selected" : null)">@sem.Text</option>
                    }
                </select>
            </div>

            @if (Model.UserRole == "STAFF")
            {
                <!-- Bộ lọc dành cho Staff: Lớp học -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="ClassId" class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-building me-1"></i>Lớp học
                    </label>
                    <select name="ClassId" id="ClassId" class="form-select rounded-3">
                        <option value="">-- Tất cả các lớp --</option>
                        @foreach (var c in Model.Classes)
                        {
                            <option value="@c.Value" selected="@(c.Selected ? "selected" : null)">@c.Text</option>
                        }
                    </select>
                </div>

                <!-- Bộ lọc dành cho Staff: Giáo viên -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="TeacherId" class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-person-badge me-1"></i>Giáo viên
                    </label>
                    <select name="TeacherId" id="TeacherId" class="form-select rounded-3">
                        <option value="">-- Tất cả giáo viên --</option>
                        @foreach (var t in Model.Teachers)
                        {
                            <option value="@t.Value" selected="@(t.Selected ? "selected" : null)">@t.Text</option>
                        }
                    </select>
                </div>

                <!-- Bộ lọc dành cho Staff: Phòng học -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="RoomId" class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-geo-alt me-1"></i>Phòng học
                    </label>
                    <select name="RoomId" id="RoomId" class="form-select rounded-3">
                        <option value="">-- Tất cả phòng học --</option>
                        @foreach (var r in Model.Rooms)
                        {
                            <option value="@r.Value" selected="@(r.Selected ? "selected" : null)">@r.Text</option>
                        }
                    </select>
                </div>
            }
            else if (Model.UserRole == "PARENT" && Model.Children.Count > 1)
            {
                <!-- Bộ lọc dành cho PHHS: Chọn con -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <label for="StudentCustomerId" class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-person-hearts me-1"></i>Học sinh (con)
                    </label>
                    <select name="StudentCustomerId" id="StudentCustomerId" class="form-select rounded-3">
                        @foreach (var ch in Model.Children)
                        {
                            <option value="@ch.Value" selected="@(ch.Selected ? "selected" : null)">@ch.Text</option>
                        }
                    </select>
                </div>
            }

            <div class="col-12 col-lg-auto ms-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4 rounded-3 d-flex align-items-center gap-2">
                    <i class="bi bi-filter"></i>
                    <span>Xem lịch</span>
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <span>Làm mới</span>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Timetable Summary Counter -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="small text-muted">
        <i class="bi bi-info-circle me-1"></i>
        Tổng cộng có <strong>@Model.TimetableItems.Count</strong> tiết học được xếp trong tuần.
    </div>
    @if (Model.UserRole != "STAFF")
    {
        <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">
            <i class="bi bi-lock me-1"></i>Chế độ xem
        </span>
    }
</div>

<!-- Timetable Grid -->
@await Html.PartialAsync("_TimetableGrid", Model)

