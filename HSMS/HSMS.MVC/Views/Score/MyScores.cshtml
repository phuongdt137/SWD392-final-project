@using System.Globalization
@model HSMS.MVC.DTOs.Score.StudentScoreReportDto
@{
    ViewData["Title"] = "Bảng điểm & Học tập - High School Management System";
    Layout = "_DashboardLayout";
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="mb-4">
    <h1 class="welcome-title h3 mb-1">Bảng điểm & Học tập</h1>
    <div class="text-muted">@Model.StudentName</div>
</div>

<div id="myScoresRoot" data-student-id="@Model.StudentCustomerId">
<form method="get" asp-action="MyScores" class="row g-2 align-items-end mb-4">
    @if (Model.Children.Count > 0)
    {
        <div class="col-md-4">
            <label class="form-label" for="studentId">Học sinh</label>
            <select name="studentId" id="studentId" class="form-select" onchange="this.form.submit()">
                @foreach (var child in Model.Children)
                {
                    <option value="@child.Id" selected="@(child.Id == Model.StudentCustomerId ? "selected" : null)">@child.Name</option>
                }
            </select>
        </div>
    }
    <div class="col-md-4">
        <label class="form-label" for="semesterId">Học kỳ</label>
        <select name="semesterId" id="semesterId" class="form-select" onchange="this.form.submit()">
            @foreach (var semester in Model.Semesters)
            {
                <option value="@semester.Id" selected="@(semester.Id == Model.SelectedSemesterId ? "selected" : null)">@semester.Name</option>
            }
        </select>
    </div>
</form>

@if (!Model.Subjects.Any())
{
    <div class="alert alert-info">Chưa có điểm nào trong học kỳ này.</div>
}

@foreach (var subject in Model.Subjects)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">@subject.SubjectName</h5>
                <span class="badge bg-primary-subtle text-primary fs-6">
                    TB môn: @(subject.WeightedAverage?.ToString("0.00", CultureInfo.InvariantCulture) ?? "—")
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Bài kiểm tra</th>
                            <th>Loại</th>
                            <th class="text-end">Trọng số</th>
                            <th class="text-end">Điểm</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in subject.Items)
                        {
                            <tr>
                                <td>@item.AssessmentName</td>
                                <td>@item.TypeName</td>
                                <td class="text-end">@item.Weight%</td>
                                <td class="text-end">@(item.Score?.ToString("0.00", CultureInfo.InvariantCulture) ?? "—")</td>
                                <td class="text-end">
                                    @if (item.ChangeCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal" data-bs-target="#historyModal"
                                                data-url="@Url.Action("MyScoreHistory", "Score", new { scoreId = item.ScoreId, studentId = Model.StudentCustomerId })">
                                            <i class="bi bi-clock-history"></i> Đã sửa @item.ChangeCount lần
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
</div>

<!-- Modal lịch sử chỉnh sửa điểm -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Lịch sử chỉnh sửa điểm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="historyBody">Đang tải...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/score-realtime.js" asp-append-version="true"></script>
    <script>
        (function () {
            var historyModal = document.getElementById('historyModal');
            historyModal.addEventListener('show.bs.modal', function (event) {
                var body = document.getElementById('historyBody');
                body.textContent = 'Đang tải...';
                fetch(event.relatedTarget.dataset.url, { credentials: 'same-origin' })
                    .then(function (response) { return response.text(); })
                    .then(function (html) { body.innerHTML = html; })
                    .catch(function () { body.textContent = 'Không tải được lịch sử.'; });
            });

            var myScoresRoot = document.getElementById('myScoresRoot');
            ScoreRealtime.start({
                rootId: 'myScoresRoot',
                joins: [{ method: 'JoinStudentScores', argument: Number(myScoresRoot.dataset.studentId) }]
            });
        })();
    </script>
}
